/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; object-src blob:; frame-src blob:; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; manifest-src 'self'; upgrade-insecure-requests

/sw.js
  Cache-Control: no-cache
/app/sw.js
  Cache-Control: no-cache

/app/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/app/vendor/*
  Cache-Control: public, max-age=2592000
/assets/*
  Cache-Control: public, max-age=86400

/ilias-connector.zip
  Cache-Control: no-cache
