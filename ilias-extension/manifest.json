{
  "manifest_version": 3,
  "name": "Booklyn ILIAS Connector",
  "short_name": "Booklyn",
  "version": "0.3.0",
  "version_name": "0.3.0 beta",
  "description": "Finds new course files on HSLU ILIAS and sends the ones you choose to Booklyn. Your sign-in never leaves your browser.",
  "homepage_url": "https://booklyn.pages.dev/connector/",
  "minimum_chrome_version": "110",
  "icons": {
    "16": "icons/ext-16.png",
    "32": "icons/ext-32.png",
    "48": "icons/ext-48.png",
    "128": "icons/ext-128.png"
  },
  "action": {
    "default_title": "Booklyn ILIAS Connector",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/ext-16.png",
      "32": "icons/ext-32.png"
    }
  },
  "permissions": ["tabs"],
  "host_permissions": ["https://elearning.hslu.ch/ilias/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://elearning.hslu.ch/ilias/*"],
      "js": ["ilias-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://booklyn.pages.dev/*",
        "https://booklyn.ch/*",
        "https://www.booklyn.ch/*",
        "http://localhost:8000/*",
        "http://127.0.0.1:8000/*"
      ],
      "js": ["booklyn-content.js"],
      "run_at": "document_idle"
    }
  ]
}
