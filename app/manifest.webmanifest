{
  "name": "Booklyn",
  "short_name": "Booklyn",
  "description": "Keep your lights on.",
  "start_url": "/app/",
  "scope": "/app/",
  "display": "standalone",
  "background_color": "#f4f0e6",
  "theme_color": "#1d5c58",
  "icons": [
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "id": "/app/",
  "lang": "en",
  "dir": "ltr",
  "categories": [
    "education",
    "productivity"
  ],
  "shortcuts": [
    {
      "name": "Port (add files)",
      "short_name": "Port",
      "url": "/app/#/port",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Search",
      "short_name": "Search",
      "url": "/app/#/search",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Deadlines",
      "short_name": "Deadlines",
      "url": "/app/#/deadlines",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/app/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": [
            "application/pdf",
            ".pdf",
            "text/plain",
            ".txt",
            "text/markdown",
            ".md",
            "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
            ".docx",
            "application/vnd.openxmlformats-officedocument.presentationml.presentation",
            ".pptx",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            ".xlsx",
            "image/*"
          ]
        }
      ]
    }
  },
  "screenshots": [
    {
      "src": "screenshots/phone-campus.png",
      "sizes": "1080x2160",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Your semester as a small city: lit floors show what is up to date"
    },
    {
      "src": "screenshots/phone-module.png",
      "sizes": "1080x2160",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "A module with its floors and final practice"
    },
    {
      "src": "screenshots/phone-deadlines.png",
      "sizes": "1080x2160",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Deadlines for every module"
    },
    {
      "src": "screenshots/phone-shop.png",
      "sizes": "1080x2160",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Spend the coins you earn by studying"
    },
    {
      "src": "screenshots/wide-campus.png",
      "sizes": "1280x800",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Booklyn on a computer"
    }
  ],
  "display_override": [
    "standalone",
    "minimal-ui"
  ]
}
